# ==============================================================================
# Venture Visionary CRM (v2.0) — 100% Open-Source Environment Configuration
# ==============================================================================

APP_NAME="Venture Visionary CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Asia/Qatar"
APP_URL=http://localhost:8090

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (PostgreSQL 16)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=vv_crm
DB_USERNAME=vv_admin
DB_PASSWORD=vv_secure_pass_2026

# Cache & Queues (Redis 7)
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Object Storage / Document Vault (MinIO S3-Compatible)
FILESYSTEM_DISK=minio
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin_secret_2026
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=vv-documents
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9002/vv-documents
AWS_USE_PATH_STYLE_ENDPOINT=true

# Open-Source WhatsApp Gateway (Evolution API / Baileys)
EVOLUTION_API_URL=http://evolution_api:8080
EVOLUTION_API_KEY=vv_evolution_token_2026
EVOLUTION_INSTANCE_NAME=venture_visionary_main

# Open-Source Omnichannel Unified Inbox (Chatwoot)
CHATWOOT_ENABLED=true
CHATWOOT_URL=http://localhost:3000
CHATWOOT_API_TOKEN=

# Mail Configuration (Local SMTP / Free Mail Server)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@venturevisionary.qa"
MAIL_FROM_NAME="Venture Visionary CRM"
